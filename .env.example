# Copy this file to .env.local and fill the values. NEVER commit .env.local.

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Check the current Flash model name in AI Studio. Example: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- Mandi prices (https://data.gov.in -> Sign up -> My Account -> API key) ---
DATA_GOV_IN_API_KEY=

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Firebase phone OTP (Project settings -> General -> Your apps -> Web app config) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# firebase = real SMS OTP. demo = OTP is always 1234 (use if Firebase is not ready or SMS quota is over)
NEXT_PUBLIC_OTP_MODE=demo

# No keys needed for: Open-Meteo (weather + geocoding), SoilGrids (soil), browser speech (STT + TTS)

# --- Natural voice (optional, strongly recommended) ---
# ElevenLabs: best Hindi voice. Key: elevenlabs.io -> Profile -> API keys. Voice: Voice Library -> pick a Hindi female voice -> copy Voice ID
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Or use Gemini's voice with the same GEMINI_API_KEY (slower, free-tier limits): set TTS_PROVIDER=gemini
TTS_PROVIDER=
GEMINI_TTS_VOICE=Kore

# Reasoning budget for answers (0 = fastest, 384 = default, 1024 = smartest/slower)
GEMINI_THINKING_BUDGET=384

# Optional: extra free Gemini keys (other Google accounts). Used automatically when the first one is rate-limited.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Model used when the main one is busy (separate free quota)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
